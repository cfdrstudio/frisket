<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.dtd/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened Runtime exceptions required by Electron. Notarization fails
    without these because V8 compiles JavaScript to machine code at runtime,
    which the hardened runtime blocks by default.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!--
    Frisket opens Markdown files from anywhere the user can reach, so it is not
    sandboxed. This entitlement is what lets it run Pandoc, which the user
    installs separately.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Reading and writing documents the user chooses. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
